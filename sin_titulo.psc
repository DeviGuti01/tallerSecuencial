Algoritmo CalcularSalario
	Definir numeroHoras,valorHoras,salarioPagar Como Real
	
	Escribir "Ingrese el numero de horas trabajadas:"
	Leer numeroHoras
	
	Escribir "Ingrese el valor de cada hora:"
	Leer valorHora
	
	salarioPagar <- numeroHoras * valorHora
	
	Escribir "El salario a pagar es: ", salarioPagar
FinAlgoritmo
