Algoritmo ControlTanque
	
	Definir litros Como Real
    
    Escribir "Ingrese la cantidad de litros del tanque: "
    Leer litros
    
	Si litros < 250 Entonces
	Escribir "La llave debe estar ABIERTA"
	
    SiNo
	Si litros > 450 Entonces
	Escribir "La llave debe estar CERRADA"
	
    SiNo
	Escribir "La cantidad de agua esta en el rango permitido"
	
FinSi

FinSi

FinAlgoritmo
