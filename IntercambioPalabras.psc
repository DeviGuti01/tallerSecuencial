Algoritmo IntercambioPalabras
    
	Definir A, B, auxiliar Como Cadena
	
    Escribir "Ingrese la palabra A:"
    Leer A
	
    Escribir "Ingrese la palabra B:"
    Leer B
	
    auxiliar <- A
    A <- B
    B <- auxiliar
	
    Escribir "El contenido de A es: ", A
    Escribir "El contenido de B es: ", B
	
FinAlgoritmo